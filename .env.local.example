# Database
DATABASE_URL="postgresql://user:password@localhost:5432/kanban-crm"

# Redis (for BullMQ)
REDIS_URL="redis://localhost:6379"

# AI Provider (Primary) - OpenAI Compatible
# You can use any provider (OpenAI, Groq, local Ollama) by setting these:
AI_API_KEY="sk-your-custom-api-key"
AI_API_BASE="https://api.your-provider.com/v1"
AI_MODEL="your-model-name"

# DeepSeek API (Fallback/Legacy)
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
DEEPSEEK_MODEL="deepseek-chat"

# NextAuth (production: https://crm.jetdigitalpro.com)
NEXTAUTH_URL="http://localhost:3099"
NEXTAUTH_SECRET="your-random-secret-here"

# Encryption key for IMAP passwords
ENCRYPTION_KEY="your-32-char-encryption-key-here"

# Zoho OAuth (Server-based Application from https://api-console.zoho.com)
ZOHO_CLIENT_ID="1000.your-zoho-client-id"
ZOHO_CLIENT_SECRET="your-zoho-client-secret"
ZOHO_REDIRECT_URI="http://localhost:3099/api/auth/zoho/callback"
# Optional: change data center (.eu, .in, .com.au) if account is not on zoho.com
# ZOHO_ACCOUNTS_URL="https://accounts.zoho.com"
# ZOHO_MAIL_API_URL="https://mail.zoho.com"

# Default admin
ADMIN_EMAIL="admin@jetdigitalpro.com"
ADMIN_PASSWORD="change-me"
