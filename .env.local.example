# Database
DATABASE_URL="postgresql://user:password@localhost:5432/kanban-crm"

# Redis (for BullMQ)
REDIS_URL="redis://localhost:6379"

# DeepSeek API
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
