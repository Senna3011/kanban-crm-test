{
  "name": "kanban-crm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3099",
    "dev:all": "concurrently -n \"next,worker\" -c \"blue,green\" \"npm run dev\" \"npm run worker\"",
    "build": "next build",
    "start": "next start -p 3099",
    "start:all": "concurrently -n \"next,worker\" -c \"blue,green\" \"npm run start\" \"npm run worker\"",
    "worker": "tsx worker/index.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.0.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.0",
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.7.0",
    "clsx": "^2.1.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^3.6.0",
    "dotenv": "^17.4.2",
    "imapflow": "^1.6.5",
    "ioredis": "^5.4.0",
    "mailparser": "^3.7.0",
    "next": "^16.3.0",
    "next-auth": "^4.24.0",
    "nodemailer": "^9.0.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hot-toast": "^2.4.0",
    "socket.io": "^4.7.0",
    "socket.io-client": "^4.7.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
